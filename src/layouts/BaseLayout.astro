---
interface Props {
  title?: string;
}

import faviconImage from '../assets/icon.svg';
---

<!DOCTYPE html>
<html lang = "en">
  	<head>
		<link rel = "icon" type = "image/svg+xml" href = {faviconImage.src} />
		<link rel = "preconnect" href = "https://googleapis.com">
  		<link rel = "preconnect" href = "https://gstatic.com" crossorigin>
		<link href = "https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
		<link href = "https://googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel = "stylesheet">
		<meta charset = "UTF-8" />
		<meta name = "viewport" content = "width=device-width, initial-scale=1.0" />
		<title>greywolffles's cabin</title>
		<style is:global>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			@font-face {
				font-family: 'Helvetica Now Condensed';
				src: url('../fonts/HelveticaNowText-Condensed.woff2') format('woff2'),
					url('../fonts/HelveticaNowText-Condensed.woff') format('woff');
				font-weight: normal;
				font-style: normal;
			}

			@font-face {
				font-family: 'Helvetica Now Condensed';
				src: url('fonts/HelveticaNowText-CondensedBold.woff2') format('woff2'),
					url('fonts/HelveticaNowText-CondensedBold.woff') format('woff');
				font-weight: bold;
				font-style: normal;
			}

			:root {
				--color-brown: #4c3019;
				--color-orange: #e56c20;
				--color-yellow: #ec9507;
				--color-green: #4d6e36;
				--color-cream: #efe8e2;
			}
			
			p {
				font-family: 'Karla', sans-serif;
				src: url('../fonts/karla-regular.woff2') format('woff2');
			}
			
			h1, h2, h3, h4, h5, h6 {
				font-family: 'Playfair Display', serif;
			}

			blockquote {
				border-left: 4px solid var(--color-orange);
				padding-left: 1rem;
				font-style: italic;
				margin: 1.5rem 0;
			}

			pre {
				background-color: var(--color-cream);
				padding: 16px;
				border-radius: 5px;
				overflow-x: auto;
			}

			pre code {
				padding: 0;
			}

			:not(pre) > code {
				background-color: var(--color-cream);
				padding: 2px 6px;
				border-radius: 4px;
			}

			ul, ol {
				font-family: 'Karla', sans-serif;
				src: url('../fonts/karla-regular.woff2') format('woff2');
				color: var(--color-brown);
				padding-left: 1.5rem; 
				margin-bottom: 1rem; 
			}

			li {
				font-family: 'Karla', sans-serif;
				src: url('../fonts/karla-regular.woff2') format('woff2');
				color: var(--color-brown);
				margin-bottom: 0.25rem;
			}

			hr {
			border: none;
			border-top: 2px solid var(--color-orange);
			margin: 1rem 0;
			}
		</style>
  	</head>
  	<body>
    	<main>
      		<slot />
    	</main>
  	</body>
</html>
