---
import '../styles/indexstyle.css';
import BaseLayout from '../layouts/BaseLayout.astro';

import SkillBadge from '../components/SkillBadge.astro';
import NavHeader from '../components/NavHeader.astro';
import NavFooter from '../components/NavFooter.astro';

import TopNewspaper from '../assets/top-newspaper.svg';
import BottomNewspaper from '../assets/bottom-newspaper.svg';

import Books from '../assets/books.svg';
import BrownTape from '../assets/brown-tape.svg';
import YellowArrow from '../assets/yellow-arrow.svg';

import FiveStar from '../assets/five-star.svg';
import ElevenStar from '../assets/eleven-star.svg';
import SamHero from '../assets/sam-hero.svg';

import Ipod from '../assets/ipod.svg';
import Vinyl from '../assets/vinyl.svg';

import BrownArrow from '../assets/brown-arrow.svg';

import SamExp from '../assets/sam-exp.svg';

// List of three main experiences
const experiences = [
	{title: "UP Engineering Freshie Council | Mechanical Engineering Representative", text: "Represented a batch of ~70 mechanical engineering students + Spearheaded writing and editing of math, physics, and chemistry reviewers"},
	{title: "UP Biomedical Engineering Circle | Marketing & Creatives Head", text: "Spearheaded merchandise releases as income-generating projects + Founded UP BMEC as a founding executive committee member"},
	{title: "Astronomy on Tap - Manila | Assistant Finance Head", text: "Developed budget and inventory trackers for AOT - manila events + Assisted in leading the finance committee for event planning tasks"},
];
---

<BaseLayout title = "greywolffles's cabin">

	<NavHeader/>

	<!-- hero -->
	<section class = "hero-wrapper">
		<TopNewspaper width = {600} height = {600} class = "top-newspaper"/>
    	<div class = "hero-card">
			<!-- intro -->
			<div class = "hero-intro">
				<h1 class = "hero-title">
					Hi, I'm <span class = "hero-name">Sam!</span>
				</h1>
				<p class = "hero-text">
					I'm a sophomore engineering student who often dabbles in data, design, and development projects. Alongside my academic workload, I dedicate my time to learning new programming languages, designing fun products, or wrangling interesting datasets. When I'm not doing work, you can find me listening to <a href="https://open.spotify.com/show/5Pjt7qlcii0gLqvccowYhs?si=51e18d2d870e4730" class = "hero-link">horror podcasts</a>, playing <a href = "https://www.kakuroconquest.com/" class = "hero-link">Kakuro</a>, or eating gyudon.
				</p>
				<p class = "hero-text">
					I consider this website a collection of my various interests, from engineering to statistics to computer science. Feel free to look around in <b>projects</b> for my STEM works, <b>blog</b> for my ramblings, and <b>creatives</b> for my art (in progress, sorry!). <b>Contacts</b> is also a WIP, but my email, GitHub, and Linkedin can be found at the bottom of this page. :]
				</p>
			</div>
			
			<!-- guestbook area -->
			 
			
			<div class = "hero-guestbook">
				<YellowArrow width = {150} height = {150} class = "yellow-arrow"/>
				<a href = "mailto:samnicole.gianan@gmail.com">
					<Books class = "books"/>
				</a>
				<p class = "guestbook-text">Drop a message!</p>
				<BrownTape width = {300} height = {300} class = "brown-tape"/>
			</div>

			<!-- pics -->
			<div class = "hero-layer-wrapper">
				<FiveStar width = {100} height = {100} class = "five-star"/>
				<ElevenStar width = {400} height = {400} class = "eleven-star"/>
				<SamHero class = "hero-portrait"/>
			</div>
		</div>

		<Ipod class = "ipod"/>
		<Vinyl class = "vinyl"/>

		<div class = "learn">
			<BrownArrow width = {150} height = {150} class = "brown-arrow"/>
			<h1 class = "learn-text">I learn . . .</h1>
		</div>
		<BottomNewspaper width = {600} height = {600} class = "bottom-newspaper"></BottomNewspaper>
    </section>
	
	<!-- skills -->
	<section class = "skills">

		<!-- data -->
		<div class = "data-sections aligment-left">
			<div class = "skills-grid">
				<div class = "badge-row">
					<SkillBadge name = "R" variant = "orange"/>
					<SkillBadge name = "Python" variant = "orange"/>
          			<SkillBadge name = "SQL" variant = "orange"/>
					<SkillBadge name = "Power BI" variant = "orange"/>
          			<SkillBadge name = "Excel" variant = "orange"/>
				</div>
				<div class = "skill-type">
					<h2 class = "skill-title">Data!</h2>
					<h4 class = "skill-subtitle">Subject of focus.</h4>
				</div>
			</div>
			<p class = "skill-desc">I consider data my first love, and messing around with spreadsheets for organizations or even personal projects is a hobby of mine since the pandemic. I actively learn this alongside my degree, and regularly do projects to expand my skills! My most recent project is a data science project visualizing and analyzing the interesting relationship between energy consumption, electricity access, and economic activity.</p>
		</div>

		<svg class = "diagonal-divider" viewBox = "0 0 100 100" preserveAspectRatio = "none">
		<polygon fill = "var(--color-orange)" points = "0, 0 100, 0 0, 100"></polygon>
		<polygon fill = "var(--color-brown)" points = "0, 100 100, 0 100, 100"></polygon>
		</svg>

		<!-- design -->
		<div class = "design-sections aligment-right">
			<div class = "skills-grid">
				<div class = "badge-row">
					<SkillBadge name = "Fusion360" variant = "brown"/>
          			<SkillBadge name = "Blender" variant = "brown"/>
					<SkillBadge name = "Inkscape" variant = "brown"/>
					<SkillBadge name = "Canva" variant = "brown"/>
				</div>
				<div class = "skill-type">
					<h2 class = "skill-title">Design!</h2>
					<h4 class = "skill-subtitle">Home base.</h4>
				</div>
			</div>
			<p class = "skill-desc">I like to think that my coursework as a mechanical engineering student helps me develop creative thinking, both for analytical and artistic works. Much of my experience lies here, with many of my competitions, volunteer work, and organizations revolving around engineering and product design. Not only do I enjoy 3D modelling, machine operations, and other design and manufacturing methods, but I also find joy in the project planning aspect of it.</p>
		</div>

		<svg class = "diagonal-divider" viewBox = "0 0 100 100" preserveAspectRatio = "none">
		<polygon fill = "var(--color-brown)" points = "0, 0 100, 0 100, 100"></polygon>
		<polygon fill = "var(--color-green)" points ="0, 0 100, 100 0, 100"></polygon>
		</svg>

		<!-- dev -->
		<div class = "dev-sections aligment-left">
			<div class = "skills-grid">
				<div class = "badge-row">
					<SkillBadge name = "HTML" variant = "green"/>
          			<SkillBadge name = "CSS" variant = "green"/>
					<SkillBadge name = "JavaScript" variant = "green"/>
					<SkillBadge name = "Astro" variant = "green"/>
				</div>
				<div class = "skill-type">
					<h2 class = "skill-title">Dev!</h2>
					<h4 class = "skill-subtitle">Bucket list.</h4>
				</div>
			</div>
			<p class = "skill-desc">I do this the least often, but I always enjoy a good challenge for learning dev projects! I used to make a lot of websites during the pandemic, and I'm currently updating my skillset to continue this hobby of mine. This website is one of the first steps to doing that!</p>
		</div>
	</section>

	<!-- exp, educ, and tinker -->
	<section class = "exp">
		<div class = "exp-grid">

			<!-- exp -->
			<div class = "card card-experience">
				<h3 class = "column-title">Experience</h3>
				<div class = "timeline">
					{experiences.map((exp) => (
						<div class = "timeline-item">
							<div class = "timeline-dot"></div>
							<p class = "timeline-header">{exp.title}</p>
							<p class = "timeline-body">{exp.text}</p>
						</div>
					))}
				</div>
			</div>

			<!-- educ -->
			<div class = "card card-education">
				<h3 class = "column-title">Education</h3>
				<div class = "educ-list">
					<div class = "educ-item">
						<div class = "educ-icon">🌻</div> 
						<p class = "educ-school">University of the Philippines - Diliman</p>
						<p class = "educ-degree">BS Mechanical Engineering + Oblation and DOST Scholar</p>
					</div>
					<div class = "educ-item">
						<div class = "educ-icon">🔥</div>
						<p class = "educ-school">Philippines Science High School - Main Campus</p>
						<p class = "educ-degree">Physics Core + Engineering and Tech Electives</p>
					</div> 
				</div>
			</div>

			<div class = "profile-sidebar">
				<div class = "image-wrapper">
					<SamExp width = {350} height = {350} class = "exp-portrait"/>
				</div>
				
				<div class = "contacts-bar">
					<div class = "contacts-title">Contacts</div>
					<div class = "contact-icons">
					<a href = "mailto:snsgianan@gmail.com" class = "icon-link"><i class = "icon-mail">✉</i></a>
					<a href = "https://github.com/greywolffles" class = "icon-link"><i class = "icon-github">GitHub</i></a>
					<a href = "https://www.linkedin.com/in/samantha-nicole-gianan/" class = "icon-link"><i class = "icon-linkedin">LinkedIn</i></a>
					</div>
				</div>
			</div>

			<!-- tinker -->
			<div class = "card card-tinkers">
				<h3 class = "column-title">Tinkers-to-Do</h3>
				<div class = "tinker-grid">
					<div class = "tinker-box">
						<p>Projects Page</p>
					</div>
					<div class = "tinker-box">
						<p>Blog Page</p>
					</div>
					<div class = "tinker-box">
						<p>Creatives Page</p>
					</div>
				</div>
			</div>
		</div>
	</section>
	<NavFooter/>
</BaseLayout>