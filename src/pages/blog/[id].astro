---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavHeader from '../../components/NavHeader.astro';
import NavFooter from '../../components/NavFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const blogEntries = await getCollection('blog');
	return blogEntries.map((entry: any) => ({
		params: { id: entry.id }, props: { entry },
	}));
}

const { entry } = Astro.props as any;
const { Content } = await render(entry);

---

<BaseLayout title = {`${entry.data.title} | greywolffles`}>
	<div class="page-container">
		<NavHeader />

		<main class="single-post-wrapper">
		<a href = "/blog" class = "back-link">← Back to Blog</a>
		
		<article class = "reading-body">
			<header class = "post-header">
			<h1>{entry.data.title}</h1>
			<p class = "post-meta">
				Published on {new Date(entry.data.pubDate).toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric'
				})}
			</p>
			</header>
			
			<div class="markdown-content">
			<Content />
			</div>
		</article>
		</main>

		<NavFooter />
	</div>
	</BaseLayout>

	<style>
	body {
		background-color: var(--color-cream);
	}

	.page-container {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.single-post-wrapper {
		max-width: 950px;
		margin: 40px auto;
		padding: 0 24px;
		flex: 1;
		width: 100%;
		box-sizing: border-box;
	}

	.back-link {
		color: var(--color-orange);
		text-decoration: none;
		font-family: 'Karla', sans-serif;
		src: url('../fonts/karla-regular.woff2') format('woff2');
		font-weight: bold;
		display: inline-block;
		margin-bottom: 24px;
	}
	.back-link:hover {
		text-decoration: underline;
	}
	.post-header h1 {
		font-family: 'Georgia', serif;
		font-size: 2.8rem;
		color: var(--color-brown);
		margin: 0 0 8px 0;
	}
	.post-meta {
		font-family: 'Karla', sans-serif;
		src: url('../fonts/karla-regular.woff2') format('woff2');
		font-style: italic;
		color: var(--color-brown);
		opacity: 0.7;
		border-bottom: 2px solid var(--color-brown);
		padding-bottom: 16px;
		margin-bottom: 32px;
	}

	.markdown-content :global(p) {
		font-family: 'Karla', sans-serif;
		src: url('../fonts/karla-regular.woff2') format('woff2');
		font-size: 1.1rem;
		line-height: 1.6;
		color: var(--color-brown);
		margin-top: 24px;
		margin-bottom: 24px;
		text-align: justify;
	}

	.markdown-content :global(h1),
	.markdown-content :global(h2), 
	.markdown-content :global(h3),
	.markdown-content :global(h4),
	.markdown-content :global(h5),
	.markdown-content :global(h6) {
		font-family: 'Georgia', serif;
		color: var(--color-orange);
		margin-top: 12px;
		margin-bottom: 6px;
	}
</style>
