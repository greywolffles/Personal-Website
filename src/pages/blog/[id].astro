---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavHeader from '../../components/NavHeader.astro';
import NavFooter from '../../components/NavFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry: any) => ({
    params: { id: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props as any;
const { Content } = await render(entry);

---

<BaseLayout title={`${entry.data.title} | greywolffles`}>
  <NavHeader />

  <main class="single-post-wrapper">
    <a href="/blog" class="back-link">← Back to Blog</a>
    
    <article class="reading-body">
      <header class="post-header">
        <h1>{entry.data.title}</h1>
        <p class="post-meta">
          Published on {new Date(entry.data.pubDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </p>
      </header>
      
      <div class="markdown-content">
        <Content />
      </div>
    </article>
  </main>

  <NavFooter />
</BaseLayout>

<style>
  .single-post-wrapper {
    max-width: 750px;
    margin: 40px auto;
    padding: 0 24px;
  }
  .back-link {
    color: var(--color-orange);
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-weight: bold;
    display: inline-block;
    margin-bottom: 24px;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .post-header h1 {
    font-family: 'Georgia', serif;
    font-size: 2.8rem;
    color: var(--color-brown);
    margin: 0 0 8px 0;
  }
  .post-meta {
    font-family: Arial, sans-serif;
    font-style: italic;
    color: var(--color-brown);
    opacity: 0.7;
    border-bottom: 2px solid #3d2314;
    padding-bottom: 16px;
    margin-bottom: 32px;
  }

  .markdown-content :global(p) {
    font-family: Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-brown);
    margin-bottom: 24px;
  }
  .markdown-content :global(h2), .markdown-content :global(h3) {
    font-family: 'Georgia', serif;
    color: var(--color-brown);
    margin-top: 32px;
    margin-bottom: 12px;
  }
</style>
