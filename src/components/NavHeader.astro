---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<header class = "nav-header">
		<div class = "brand-side">
			<a href = "/" class = "logo-text">greywolffles</a>
		</div>

		<nav class = "nav-side">
			<a href = "/projects" class = "nav-tab proj-link">
				<svg class = "gear-icon" viewBox = "0 0 24 24" fill = "none" stroke = "currentColor" stroke-width = "2" stroke-linecap = "round" stroke-linejoin = "round">
					<circle cx = "12" cy = "12" r = "3"></circle>
					<path d = "M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
				</svg>
				projects
			</a>
			<a href = "/blog" class = "nav-tab">blog</a>
			<a href = "/creatives" class = "nav-tab">creatives</a>
			<a href = "/contacts" class = "nav-tab">contacts</a>
		</nav>
	</header>
</BaseLayout>

<style>
    .nav-header {
		display: flex;
		width: 100%;
		height: 70px;
		z-index: 20;
    }

	.brand-side {
		background-color: var(--color-brown);
		flex: 1.2;
		display: flex;
		align-items: center;
		padding-left: 2.5rem;
	}

	.logo-text {
		color: var(--color-cream);
		font-size: 1.6rem;
		font-weight: bold;
		text-decoration: none;
		letter-spacing: -0.5px;
	}

	.nav-side {
		background-color: var(--color-brown);
		flex: 1.5;
		display: flex;
		align-items: center;
	}

	.nav-tab {
		color: var(--color-cream);
		text-decoration: none;
		font-size: 1.1rem;
		font-weight: 500;
		height: 100%;
		display: flex;
		align-items: center;
		padding: 0 1.5rem;
		transition: opacity 0.2s ease;
    }

	.nav-tab:hover {
    	opacity: 0.8;
  	}

	.proj-link {
		background-color: var(--color-orange);
    	padding: 0 2rem;
		margin-left: auto;
	}

	.gear-icon {
		width: 1.8rem;
		height: 1.8rem;
		color: var(--color-cream);
		margin-right: 0.6rem;
	}

	@media screen and (max-width: 768px) {
		.navbar {
			display: none;
		}
	}

</style>